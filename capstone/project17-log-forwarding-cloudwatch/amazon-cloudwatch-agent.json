{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/amrish-capstone/app.log",
            "log_group_name": "/amrish-capstone/project17-app-logs",
            "log_stream_name": "{hostname}-app-stream",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "/amrish-capstone/project17-syslog",
            "log_stream_name": "{hostname}-syslog-stream",
            "retention_in_days": 7
          }
        ]
      }
    }
  }
}
